<?php if ($textInput): ?>
<?php echo $this->formElement($textInput); ?>
<?php elseif ($singleSelect): ?>
<?php echo $this->formElement($singleSelect); ?>
<?php else: ?>
<?php
$truncate = $facet->data('truncate_values');
if ('single_list' === $facet->data('select_type') && $truncate) {
    $truncate++;
}
?>
<ul class="select-list" id="select-list-<?php echo $facet->id(); ?>" data-truncate-list-items="<?php echo $this->escapeHtml($truncate); ?>">
    <?php if ('single_list' === $facet->data('select_type')): ?>
    <li class="select-list-item">
        <label>
            <input
                class="value"
                type="radio"
                name="<?php echo sprintf('value_%s', $facet->id()); ?>"
                data-property-id=""
                data-value="">
                <?php echo $this->translate('All'); ?>
        </label>
    </li>
    <?php endif; ?>
    <?php foreach ($values as $key => $value): ?>
    <?php
    $dataPropertyId = $facet->data('property_id');
    $dataValue = $key;
    if (in_array($facet->data('query_type'), ['ex', 'nex'])) {
        $dataPropertyId = $key;
    }
    ?>
    <li class="select-list-item">
        <label>
            <input
                class="value"
                type="<?php echo ('multiple_list' === $facet->data('select_type')) ? 'checkbox' : 'radio'; ?>"
                name="<?php echo sprintf('value_%s', $facet->id()); ?>"
                data-property-id="<?php echo $this->escapeHtml($dataPropertyId); ?>"
                data-value="<?php echo $this->escapeHtml($dataValue); ?>">
                <?php echo $this->escapeHtml($value); ?>
        </label>
    </li>
    <?php
    endforeach;
    ?>
</ul>
<button type="button" class="select-list-expand" aria-expanded="false" aria-controls="select-list-<?php echo $facet->id(); ?>" style="display: none;"><?php echo $this->translate('See more'); ?> <span class="select-list-hidden-count"></span></button>
<button type="button" class="select-list-collapse" aria-expanded="true" aria-controls="select-list-<?php echo $facet->id(); ?>" style="display: none;"><?php echo $this->translate('See less'); ?></button>
<?php endif; ?>
